---
import { SITE_NAME } from "../site";

type Props = {
  href?: string;
  label?: string;
};

const { href = "/", label = "Legiara home" } = Astro.props as Props;
---

<a class="brand-lockup" href={href} aria-label={label}>
  <img
    class="brand-lockup__mark"
    src="/brand/mark.png"
    width="36"
    height="36"
    alt=""
    aria-hidden="true"
  />
  <span class="brand-lockup__word">{SITE_NAME.toLowerCase()}</span>
</a>
